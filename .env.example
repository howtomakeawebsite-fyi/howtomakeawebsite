# Copy this file to .env.local for testing on your own computer.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# Names only: never write real keys in this file. See README.md for what each one does.

# The address of your live website, for example https://yourchurch.example
# (optional: the address in content/settings.json is used otherwise)
NEXT_PUBLIC_SITE_URL=

# Contact and prayer forms (Resend). The forms say "form email is not set up yet" until all three are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# "Verify you are human" box on the forms (Cloudflare Turnstile). Off until both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: these two can also be set in content/settings.json (Pages CMS). A value here wins.
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
EVENTS_ICS_URL=

# Optional: a YouTube Data API key gives exact video dates and descriptions. The Sermons page works without it.
YOUTUBE_API_KEY=

# Optional: search engine ownership codes (Google Search Console, Bing Webmaster Tools)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
